
<!DOCTYPE html>
<html lang="pt-br">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">

        @* Fonte personalizada *@
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&display=swap" rel="stylesheet">

  
        @* CSS da aplicação *@
        <link rel="stylesheet" href="~/css/styles.css">

        <title>@ViewBag.Titulo - Gestão de Equipamentos</title>
    </head>
    <body>
        <nav>
            <h1>Gestão de Equipamentos</h1>

                <div class="links-navbar">
                    <a class="links-navbar" href="/">Início</a> 
                    <a class="links-navbar" asp-action="Fabricante" asp-action="Listar">Controle de Fabricantes</a> 
                    <a class="links-navbar" asp-action="Equipamento" asp-action="Listar">Controle de Equipamentos</a> 
                    <a class="links-navbar" asp-action="Chamado" asp-action="Listar">Controle de Chamados</a> 
                </div>
        </nav>

        <head>
            <h2>@ViewBag.Titulo</h2>
        </head>

        <main>
            @RenderBody()
        </main>
    </body>
</html>
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Editar Fabricante";
}
@using GestaoDeEquipamentoss.Web.ModuloFabricante

@model Fabricante;




<form class="formulario" action="/Fabricante/Editar/@Model.Id" method="post">
    <div class="formulario-campo">
        <label>Nome</label>
        <br>
        <input type="text" name="Nome" value="@Model.Nome">
    </div>

    <div class="formulario-campo">
        <label>Email</label>
        <br>
        <input type="email" name="Email" value="@Model.Email">
    </div>

    <div class="formulario-campo">
        <label>Telefone</label>
        <br>
        <input type="text" name="Telefone" value="@Model.Telefone">
    </div>

    <hr>

    <div class="formulario-acoes">
        <a href="/Fabricante/Listar">Voltar</a> 
        <button type="submit">Confirmar</button>
    </div>


</form>
@{
    Layout = "_Layout";
}
@using GestaoDeEquipamentoss.Web.ModuloFabricante
@model List<Fabricante>;


<h2>Cadastrar Fabricante</h2>

<hr>
<a href="/Fabricante/Cadastrar">Cadastrar Fabricante</a>
</hr>

<table>
    <thead>
        <tr>
            <th>Id</th>
            <th>Nome</th>
            <th>Email</th>
            <th>Telefone</th>
            <th>Editar</th>
            <th>Excluir</th>
        </tr>
    </thead>

    <tbody>
        @foreach (Fabricante f in Model)
        {
            <tr>
                <td>@f.Id</td>
                <td>@f.Nome</td>
                <td>@f.Email</td>
                <td>@f.Telefone</td>
                <td><a href="/Fabricante/Editar/@f.Id">Editar</a></td>
                <td><a href="/Fabricante/Excluir/@f.Id">Excluir</a></td>
            </tr>  
        }        
    </tbody>
</table>


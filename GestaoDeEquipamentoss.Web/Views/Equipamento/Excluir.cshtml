@using GestaoDeEquipamentoss.Web.Models
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Excluir Equipamentos";

    List<ListarFabricantesViewModel> fabricantes = ViewBag.Fabricantes;
}

@model ExcluirEquipamentoViewModel

<form class="formulario" action="/Equipamento/Excluir/@Model.Id" method="post">
    <div class="formulario-campo">
        <label>Nome</label>
        <input type="text" name="Nome" value="@Model.Nome" disabled>
    </div>

    <div class="formulario-campo">
        <label>Preço Do Produto</label>
        <input type="text" name="PrecoAquisicao" min="0.01" step="0.01" value="@Model.PrecoAquisicao.ToString("C2")" disabled>
    </div>

    <div class="formulario-campo">
        <label>Data Fabricacao</label>
        <input type="text" name="DataFabricacao" value="@Model.DataFabricacao.ToString("dd/MM/yyyy")" disabled>
    </div>

    <div class="formulario-campo">
        <label>Fabricante</label>

        <input type="text" name="Fabricante" value="@Model.Fabricante" disabled>                                  

    </div>

    <hr>

    <div class="formulario-acoes">
        <a href="/Equipamento/Listar">Voltar</a> 
        <button type="submit">Confirmar</button>
    </div>
</form>